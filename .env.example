# Chave da API do Google Gemini (obrigatória para Google AI Studio)
GEMINI_API_KEY="AIzaSy..."

# Configuração opcional para Google Cloud Vertex AI (em vez do Google AI Studio)
# Para usar Vertex AI com o Google ADK e a API Live:
# GOOGLE_GENAI_USE_VERTEXAI="1"
# GOOGLE_CLOUD_PROJECT="seu-projeto-gcp"
# GOOGLE_CLOUD_LOCATION="us-central1"

# Porta do servidor web (padrão: 8000)
PORT=8000

# Modelo padrão
GEMINI_MODEL="gemini-3.8-live"

# Modelos Live selecionáveis no HUD (Modo de Operação do Assistente):
# - LIVE_MODEL_PRIMARY: padrão (gemini-3.8-live)
# - LIVE_MODEL_EXTENDED: raciocínio explícito em 2º plano (usa interaction_status;
#   exige ferramentas NON_BLOCKING + thinking_config no caminho nativo /ws/live)
# - LIVE_MODEL_FALLBACK: usado no failover de chave/cota
LIVE_MODEL_PRIMARY="gemini-3.8-live"
LIVE_MODEL_EXTENDED="gemini-3.8-live-extended-thinking"
LIVE_MODEL_FALLBACK="gemini-2.5-flash-native-audio-latest"

# Nível de raciocínio do Extended Thinking: low | medium | high (somente
# gemini-3.8-live-extended-thinking). "minimal" não é suportado pela API.
LIVE_THINKING_LEVEL="low"

# Detecção automática de idioma na sessão de voz (desligada por padrão).
# Com LIVE_AUTO_LANG=1 o modelo alterna idiomas nativamente (70+ línguas) e
# a dica fixa pt-BR é ignorada; sem isso, JARVIS_LANGUAGE trava o idioma por estabilidade.
LIVE_AUTO_LANG=0

# Voz padrão do assistente: Charon (estilo Jarvis), Puck, Fenrir, Aoede, Kore
JARVIS_VOICE="Charon"

# Token de autenticação das rotas de mutação e do WebSocket.
# Se ficar vazio, o servidor gera um token aleatório a cada inicialização.
JARVIS_TOKEN=""

# Interface de rede do servidor. Mantenha 127.0.0.1 para não expor o JARVIS na rede local.
JARVIS_HOST="127.0.0.1"

# Segundos de espera pela confirmação do usuário em ferramentas EXTERNAL_WRITE e PRIVILEGED
JARVIS_CONFIRMATION_TIMEOUT=60

# Duração (segundos) da autoridade de controle físico de mouse e teclado concedida
# após o usuário confirmar o Modo Controle
JARVIS_CONTROL_LEASE_TTL=300

# Modo Computador (Computer Use): lease de operação do navegador Chromium.
# Duração padrão 900s (15 min). O navegador abre em headless se COMPUTER_USE_HEADLESS=1.
JARVIS_COMPUTER_LEASE_TTL=900
COMPUTER_USE_MODEL="gemini-3.6-flash"
COMPUTER_USE_HEADLESS=1
COMPUTER_USE_SCREEN_W=1280
COMPUTER_USE_SCREEN_H=936

# Caminho do arquivo de preferências e memórias (padrão: user_preferences.json na raiz do projeto)
JARVIS_PREFERENCES_FILE=""

# Idioma fixo da sessão de voz. Sem isso o modelo troca de idioma sozinho em ruído
# e transcreve português como tailandês/turco.
JARVIS_LANGUAGE="pt-BR"

# Silêncio do assistente (segundos) a partir do qual o microfone volta a ser ouvido,
# sem esperar o turn_complete. Evita perder o começo da frase do usuário.
JARVIS_MIC_GRACE=1.0

# Transcrição Live: dica explícita de idioma dispensa detecção automática e
# acelera a primeira hipótese parcial. Vocabulário guia nomes próprios.
# Modo "verbatim" = mais rápido; "smart" = legível, porém mais lento.
JARVIS_TRANSCRIBE_LANGS="pt-BR"
JARVIS_TRANSCRIBE_VOCAB="JARVIS,Antigravity,Steam"
JARVIS_TRANSCRIBE_MODE="verbatim"

# Ativa os plug-ins que ainda respondem com dados simulados (Gmail, Finance, Deep Research...).
# Desligados por padrão para o assistente não relatar dados inventados como se fossem reais.
JARVIS_ATIVAR_MOCKS=0

# Visão de tela: o compartilhamento é feito pelo cliente (HUD/widget) via getDisplayMedia
# e só é aceito pelo servidor enquanto a lease de controle estiver ativa.

# ---------------------------------------------------------------------------
# Opções avançadas (valores abaixo são os padrões do código; descomente para mudar)
# ---------------------------------------------------------------------------

# Pool de chaves Gemini separadas por vírgula: rotação automática em cota/erro transitório.
# GEMINI_API_KEYS="chave1,chave2"

# Modelos de texto do Google ADK (/api/chat) e reserva
# TEXT_MODEL="gemini-flash-latest"
# TEXT_MODEL_FALLBACK="gemini-2.5-flash"

# Provedor de chat de texto ativo na inicialização: google_studio | omniroute
# AI_PROVIDER="google_studio"

# OmniRoute: proxy local OpenAI-compatible usado como 2º provedor (somente texto)
# OMNIROUTE_URL="http://127.0.0.1:20128/v1"
# OMNIROUTE_API_KEY=""
# OMNIROUTE_MODEL="gemini-2.5-flash"
# OMNIROUTE_COMBO="jarvis"
# OMNIROUTE_TIMEOUT=30

# Sessões ADK: URL SQLAlchemy; use "memoria" para sessões só em RAM
# SESSION_DB_URL="sqlite+aiosqlite:///sessoes.db"

# Memória de longo prazo (JSON local)
# JARVIS_MEMORY_FILE="/caminho/para/memoria.json"   # padrão: memoria.json na raiz do projeto
# JARVIS_MEMORY_MAX_EVENTS_PER_SESSION=100

# Cliente MCP: arquivo de servidores externos (padrão: mcp_servers.json na raiz)
# MCP_SERVERS_CONFIG=""
# LOAD_GLOBAL_MCP_CONFIG=0   # 1 = também lê ~/.gemini/config/mcp_config.json

# Barge-in: o usuário pode interromper a fala do assistente
# JARVIS_BARGE_IN=0

# Leases e sessões
# JARVIS_IDE_LEASE_TTL=300
# JARVIS_SESSAO_TTL_S=43200

# Transcritor dedicado em paralelo à sessão Live
# JARVIS_DEDICATED_TRANSCRIBE=1
# JARVIS_TRANSCRIBE_MODEL="gemini-3.5-transcribe-live"

# Ajustes opcionais da sessão Live do ADK (/ws/live_adk); 1 liga
# LIVE_PROATIVITY=0
# LIVE_AFFECTIVE_DIALOG=0    # ignorado nos modelos 3.8
# LIVE_EXPLICIT_VAD=0
# LIVE_VAD_DISABLED=0
# LIVE_ALLOW_BARGE_IN=0
# LIVE_SAVE_BLOB=0
# LIVE_METADADOS='{"chave": "valor"}'

# Compactação de eventos e cache de contexto dos agentes ADK
# COMPACTION_TOKEN_THRESHOLD=4000
# COMPACTION_RETENTION_SIZE=5
# COMPACTION_INTERVAL=10
# COMPACTION_OVERLAP_SIZE=2
# CONTEXT_CACHE_MIN_TOKENS=2048
# CONTEXT_CACHE_TTL_SECONDS=600
# CONTEXT_CACHE_INTERVALS=5

# Computer Use: páginas iniciais do navegador controlado
# COMPUTER_USE_INITIAL_URL="https://www.google.com"
# COMPUTER_USE_SEARCH_URL="https://www.google.com"
